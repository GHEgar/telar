{
    "name": "telar",
    "description": "Headless React components, one package each: calendar, dropzone, dialog, tabs, tooltip, menu, combobox and more.",
    "private": true,
    "type": "module",
    "workspaces": [
        "packages/*"
    ],
    "scripts": {
        "build": "npm run clean && tsc -b tsconfig.build.json",
        "clean": "rm -rf packages/*/dist packages/*/*.tsbuildinfo",
        "typecheck": "tsc -p tsconfig.json --noEmit",
        "lint": "eslint .",
        "test": "vitest run",
        "test:watch": "vitest",
        "demo": "vite --config demo/vite.config.ts",
        "demo:build": "vite build --config demo/vite.config.ts",
        "e2e": "playwright test"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@playwright/test": "^1.64.0",
        "@testing-library/react": "^16.3.3",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.1.2",
        "eslint": "^10.12.0",
        "eslint-plugin-react-hooks": "^7.1.1",
        "happy-dom": "^20.14.5",
        "react": "^19.3.0",
        "react-dom": "^19.3.0",
        "typescript": "~6.0.3",
        "typescript-eslint": "^8.71.1",
        "vite": "^8.3.4",
        "vitest": "^5.0.3"
    }
}
